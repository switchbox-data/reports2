all: clean render

clean:
    uv run python -m lib.just.clean

render path_qmd="":
    uv run python -m lib.just.render {{ path_qmd }}

draft path_qmd="index.qmd":
    uv run python -m lib.just.draft {{ path_qmd }}

typeset path_qmd="":
    uv run python -m lib.just.typeset {{ path_qmd }}

publish:
    uv run python -m lib.just.publish

diff label="":
    uv run python -m lib.just.diff {{ label }}

# Export each testimony figure as a high-res PNG named "Figure N.png" (one file
# per embed instance, so numbers match the rendered DOCX for manual placement).
export-figures path_qmd="expert_testimony.qmd" dpi="300":
    uv run python -m lib.just.export_figures {{ path_qmd }} --dpi {{ dpi }} --name-style word --no-dedup

# Build the CIEC-1 provenance table: every figure, table and computed number in the
# filed testimony PDF, with its page/line and a permalink to the generating notebook cell.
provenance:
    uv run python provenance/build_provenance.py

# Screenshot each native Markdown table as "Table N.png" via headless Chrome.
export-tables path_qmd="expert_testimony.qmd" scale="3":
    uv run python -m lib.just.export_tables {{ path_qmd }} --name-style word --scale {{ scale }}
