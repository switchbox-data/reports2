all: clean render

clean:
    uv run python -m lib.just.clean

render path_qmd="":
    uv run python -m lib.just.render {{ path_qmd }}

draft path_qmd="index.qmd":
    uv run python -m lib.just.draft {{ path_qmd }}

# Render expert testimony to Word in the standard testimony format; fill in its `testimony:` block first (see `just new-testimony` at the repo root)
testimony path_qmd="expert_testimony.qmd":
    uv run python -m lib.just.testimony render {{ path_qmd }}

typeset path_qmd="":
    uv run python -m lib.just.typeset {{ path_qmd }}

publish:
    uv run python -m lib.just.publish

diff label="":
    uv run python -m lib.just.diff {{ label }}

export-figures path_qmd="" dpi="300":
    uv run python -m lib.just.export_figures {{ path_qmd }} --dpi {{ dpi }}

# Build the provenance table for the direct testimony: every figure, table and computed number
# in the filed PDF, with its page/line and a permalink to the generating notebook cell.
# path_exec_dir: reports/md_hp_rates in a checkout of the md_bge_submission tag whose notebooks
# have been rendered there, so the numbers come from the code as filed (see the script's docstring).
provenance-direct path_exec_dir:
    uv run python provenance/direct/build_provenance.py --path-exec-dir {{ path_exec_dir }}

# Build the provenance table for the surrebuttal's new analysis only (the ResStock rerun in Table 1
# and the sentences built on it); numbers repeated from the direct testimony are left out.
# path_exec_dir: reports/md_hp_rates in a checkout of the md_bge_surrebuttal tag whose notebooks
# have been rendered there (see the script's docstring).
provenance-surrebuttal path_exec_dir:
    uv run python provenance/surrebuttal/build_provenance.py --path-exec-dir {{ path_exec_dir }}
