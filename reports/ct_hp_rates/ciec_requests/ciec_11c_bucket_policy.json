{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadCiec11c",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::switchbox-public-data/ct_hp_rates/pura_26-05-10/ciec-11c/*"
    },
    {
      "Sid": "PublicListCiec11c",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::switchbox-public-data",
      "Condition": {
        "StringLike": {
          "s3:prefix": "ct_hp_rates/pura_26-05-10/ciec-11c/*"
        }
      }
    },
    {
      "Sid": "DenyNonHttps",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::switchbox-public-data",
        "arn:aws:s3:::switchbox-public-data/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
